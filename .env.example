# LabFlow runtime configuration. Copy to `.env` and edit.
# All variables are prefixed with LABFLOW_.

# --- core ---------------------------------------------------------------
LABFLOW_DATABASE_URL=sqlite:///./labflow.db
# postgresql+psycopg://labflow:labflow@localhost:5432/labflow
LABFLOW_ENVIRONMENT=development
LABFLOW_LOG_LEVEL=INFO
LABFLOW_LOG_JSON=false
# Comma-separated list. Leave empty to disable CORS.
LABFLOW_CORS_ORIGINS=

# --- security -----------------------------------------------------------
# Set to "true" in production. When false, single-team mode is used.
LABFLOW_AUTH_ENABLED=false
LABFLOW_BOOTSTRAP_TEAM=default
# If set, an API key with this plaintext is created for the bootstrap team
# at first boot. Used for local development only — generate per-team keys
# via `labflow keys create` in production.
LABFLOW_BOOTSTRAP_API_KEY=

# --- limits -------------------------------------------------------------
LABFLOW_MAX_TRANSCRIPT_BYTES=1000000
LABFLOW_DEFAULT_PAGE_SIZE=50
LABFLOW_MAX_PAGE_SIZE=200

# --- extraction backend -------------------------------------------------
# rules | llm
LABFLOW_EXTRACTION_BACKEND=rules
# Dotted path to a callable used by the LLM backend.
# Signature: complete(prompt: str, *, system: str | None = None) -> str
# The callable must return a JSON string conforming to ExtractionResult.
LABFLOW_LLM_CALLABLE=

# --- webhooks (v0.3) ----------------------------------------------------
# Default HMAC secret for outbound webhook signatures (per-subscription
# secrets override this). Generate with `python -c 'import secrets; print(secrets.token_urlsafe(32))'`.
LABFLOW_WEBHOOK_SIGNING_SECRET=
# Shared secret configured on your GitHub webhook for inbound events.
LABFLOW_GITHUB_WEBHOOK_SECRET=
